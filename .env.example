# ---------- Model provider ----------
# ollama (default, local & free) | azure (Azure OpenAI / Foundry, v1 endpoint) | scripted (test double, no AI)
LLM_PROVIDER=ollama
CHAT_MODEL=corp-qwen2.5          # created by scripts/setup_mac.sh from qwen2.5:7b or qwen2.5:latest (same model), 8k context
EMBED_MODEL=bge-m3               # multilingual (Arabic + English); do not use nomic-embed-text (English-only)
# LLM_BASE_URL=http://localhost:11434/v1

# ---------- Azure (optional; adapters included but untested) ----------
# LLM_PROVIDER=azure
# CHAT_MODEL=gpt-5-mini                     # your deployment name
# EMBED_MODEL=text-embedding-3-small        # your deployment name
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=<key>
# SEARCH_BACKEND=azure
# AZURE_SEARCH_ENDPOINT=https://<search>.search.windows.net
# AZURE_SEARCH_API_KEY=<admin key>
# AZURE_SEARCH_INDEX=corp-policies
# AZURE_CONTENT_SAFETY_ENDPOINT=https://<contentsafety>.cognitiveservices.azure.com
# AZURE_CONTENT_SAFETY_KEY=<key>
# APPLICATIONINSIGHTS_CONNECTION_STRING=<connection string>

# ---------- App ----------
SEARCH_BACKEND=local
RETRIEVAL_TOP_K=6
GROUNDEDNESS_THRESHOLD=4
ENTERPRISE_MCP_URL=http://127.0.0.1:8765/mcp
DEMO_IDENTITY_SECRET=change-me-local-demo-secret-32-bytes
# Send traces to the Aspire dashboard / Jaeger (optional):
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# Set to false on slow laptops to skip the LLM groundedness judge (faster demo; evals should keep it on)
ENABLE_JUDGE=true
